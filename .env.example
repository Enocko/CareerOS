# Database
DATABASE_URL=postgres://careeros:careeros@localhost:5433/careeros?sslmode=disable

# Environment
CAREEROS_ENV=development

# API
API_PORT=8080
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_EXPIRY_HOURS=24
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Auth cookies (production: COOKIE_SECURE=true, COOKIE_SAMESITE=None for cross-origin frontend)
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# Admin access (comma-separated emails)
CAREEROS_ADMIN_EMAILS=admin@example.com

# Observability
METRICS_ENABLED=true
# METRICS_TOKEN=optional-bearer-token-when-metrics-enabled

# Frontend (used at Vite build time)
# Leave empty for local dev so Vite proxies /api to :8080. Set API URL for production builds only.
VITE_API_URL=

# Ingestion (USAJobs — request a free key at https://developer.usajobs.gov)
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=you@example.com

# Production Render DB — set in local .env only (gitignored). Used by ./scripts/ingest-production.sh
# PRODUCTION_DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
